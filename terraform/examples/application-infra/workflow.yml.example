name: Terraform application

on:
  pull_request:
    paths:
      - "terraform/**"
      - ".github/workflows/terraform.yml"
  push:
    branches: [main]
    paths:
      - "terraform/**"
      - ".github/workflows/terraform.yml"
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: terraform-NOME-DO-PROJETO-production
  cancel-in-progress: false

jobs:
  terraform:
    uses: jvsajv/almeidas-server-infra/.github/workflows/terraform-kubernetes.yml@main
    with:
      working_directory: terraform
      var_file: environments/production.tfvars
      kube_api_server: ${{ vars.KUBE_API_SERVER }}
      apply: ${{ github.event_name == 'push' && github.ref == 'refs/heads/main' && vars.TERRAFORM_APPLY_ENABLED == 'true' }}
    secrets:
      TS_OAUTH_CLIENT_ID: ${{ secrets.TS_OAUTH_CLIENT_ID }}
      TS_OAUTH_SECRET: ${{ secrets.TS_OAUTH_SECRET }}
      KUBECONFIG_BASE64: ${{ secrets.KUBECONFIG_BASE64 }}
